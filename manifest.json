			},
			"condition": "mod_enabled(\"Atampy26.InvertedStreakSuits@1.0.0\")"
		},
		{
			"id": "black",
			"type": "boolean",
			"name": "Black Streak",
			"description": "Slim down the Black Streak.",
			"defaultValue": true,
			"data": { "contentFolders": ["suits/black_streak"] }
		},
		{
			"id": "blue",
			"type": "boolean",
			"name": "Blue Streak",
			"description": "Slim down the Blue Streak.",
