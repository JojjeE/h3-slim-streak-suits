{
	"$schema": "../../manifest-schema.json",
	"id": "Jojje.SlimStreakSuits",
	"name": "Slim Streak Suits",
	"description": "Alter the Streak suits to use the Hitman 2 slim fit signature suit models.",
	"authors": ["Jojje"],
	"version": "1.3.0",
	"frameworkVersion": "3.0.0-rc.1",
	"url": "https://github.com/JojjeE/h3-slim-streak-suits",
	"conditions": { "supportedGames": ["h3"] },
	"data": {
		"contentFolders": ["base"],
		"deployAfter": ["Atampy26.InvertedStreakSuits@^1.0.0"]
